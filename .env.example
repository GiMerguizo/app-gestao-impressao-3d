# Copie para ".env" (cp .env.example .env) e ajuste. O .env NÃO vai para o Git.
# Aqui ficam apenas configurações. A senha do banco fica em secrets/db_password.txt.

# ------------------------------------------------------------ Aplicação
TZ=America/Sao_Paulo
# Imagem do PostgreSQL. Trocar a versão principal (17 -> 18) exige dump/restauração: ver docs/OPERACAO.md.
PG_IMAGE=postgres:17-alpine

# Endereço onde o Nginx escuta no notebook. Mantenha 127.0.0.1: o acesso externo é feito pelo tailscale serve.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# true = cookie só trafega em HTTPS (padrão, com tailscale serve --https).
# false = apenas se você optar por HTTP dentro da tailnet (o tráfego Tailscale já é criptografado).
COOKIE_SECURE=true

# Sessão: expira após X horas sem uso, e no máximo após Y dias mesmo com uso.
SESSAO_INATIVIDADE_HORAS=72
SESSAO_MAX_DIAS=30

# Bloqueio de login após falhas (por usuário e por IP), dentro da janela em minutos.
LOGIN_MAX_FALHAS_USUARIO=8
LOGIN_MAX_FALHAS_IP=20
LOGIN_JANELA_MIN=15

# Limites de memória (notebook com 4 GB: valores abaixo funcionam bem).
DB_MEM_LIMIT=768m
BACKEND_MEM_LIMIT=384m

# ------------------------------------------------------------ Backup (scripts/backup.sh)
# Pasta local dos backups (no disco interno do notebook).
BACKUP_DIR=/srv/erp3d/backups
# Retenção local: diários (dias), semanais (quantidade), mensais (quantidade).
RETENCAO_DIARIOS=14
RETENCAO_SEMANAIS=8
RETENCAO_MENSAIS=12

# Cópia 1: disco externo USB, montado neste ponto (ver docs/INSTALACAO.md, passo 8).
# Deixe vazio para desativar (não recomendado).
DISCO_EXTERNO=/mnt/backup-erp3d
RETENCAO_EXTERNO_DIAS=180

# Cópia 2: local independente. Opções: rclone | rsync | nenhum
#   rclone: nuvem gratuita (Google Drive, OneDrive...). O arquivo vai CRIPTOGRAFADO com age.
#   rsync : computador do outro sócio, pela Tailscale (ssh).
OFFSITE_METODO=nenhum
# Para rclone: nome do remoto configurado com "rclone config" e pasta. Ex.: gdrive:backups-erp3d
RCLONE_DESTINO=
RETENCAO_OFFSITE_DIAS=90
# Para rsync: usuario@maquina-do-socio:/caminho  (nome MagicDNS da Tailscale)
RSYNC_DESTINO=
# Chave pública age (começa com "age1..."). Obrigatória para rclone; recomendada para rsync.
AGE_RECIPIENT=

# ------------------------------------------------------------ Monitoramento (scripts/monitorar.sh)
# Opcional. Tópico do ntfy (app gratuito de notificações no celular). Use um nome longo e aleatório.
# Ex.: https://ntfy.sh/erp3d-9f3k2m7q1x
NTFY_URL=
# Opcional. URLs de "ping" do healthchecks.io (plano gratuito): avisam quando o notebook PARA de responder
# (falta de luz, internet ou travamento), coisa que o próprio notebook não consegue avisar.
HC_MONITOR_URL=
HC_BACKUP_URL=
# Alertas
ALERTA_DISCO_PCT=85
ALERTA_BACKUP_HORAS=26
ALERTA_TESTE_RESTAURACAO_DIAS=8
